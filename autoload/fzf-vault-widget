#!/usr/bin/env zsh
# File: ~/arch-projects/XC-Manager/autoload/fzf-vault-widget

# --- Identify Active Vault (v0.3.0 logic) ---
local vault_dir="${XC_VAULT_DIR:-$HOME/.local/share/xc}"
local state_file="$HOME/.cache/xc_active_vault"
local active_name="main"

# Identify which vault is active
[[ -f "$state_file" ]] && active_name=$(<"$state_file")
local vault_file="$vault_dir/${active_name}.txt"

# If the file doesn't exist, show a helpful message and exit
if [[ ! -f "$vault_file" ]]; then
    zle -M "Vault '$active_name' not found in $vault_dir"
    return 1
fi

# We switched to {+n} and used a simpler sed command.
# If {n} was off by one, we will use {+n} or a literal sed adjustment.
local selected=$(fzf \
    --height 40% \
    --layout=reverse \
    --border \
    --prompt="⚡ Vault > " \
    --color="gutter:-1,border:8,header:4,info:2,pointer:5,marker:13,fg+:7,prompt:5,hl:12" \
    --header "Vault: [$active_name] | Enter: Paste | Alt-D: Delete" \
    --delimiter=" -> " \
    --with-nth=1 \
    --preview-window="up:3:wrap" \
    --preview 'line={}; echo ${line#* -> }' \
    --bind "alt-d:execute(sed -i \"\$(({n}+1))d\" \"$vault_file\")+reload(cat \"$vault_file\")" \
    < "$vault_file")

if [ -n "$selected" ]; then
    local cmd="${selected%% -> *}"
    LBUFFER="${cmd%"${cmd##*[![:space:]]}"}"
fi
zle redisplay
