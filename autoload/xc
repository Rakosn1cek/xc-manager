#!/usr/bin/env zsh
# File: ~/arch-projects/XC-Manager/autoload/xc

readonly XC_VERSION="0.4.0-beta"
setopt EXTENDED_GLOB

# ==============================================================================
# SECTION 1: CONFIGURATION & PATHS
# ==============================================================================
# --- SECTION 1: DYNAMIC CONFIG ---
local vault_dir="${XC_VAULT_DIR:-$HOME/.local/share/xc}"
local state_file="$HOME/.cache/xc_active_vault"

# Ensure the vault directory exists (The Arch way: don't assume, verify)
[[ ! -d "$vault_dir" ]] && mkdir -p "$vault_dir"

# Read the name of the active vault (default to 'main' if file is missing)
local active_name="main"
[[ -f "$state_file" ]] && active_name=$(<"$state_file")

# This is our actual working file for this session
local vault_file="$vault_dir/${active_name}.txt"

# ==============================================================================
# SECTION 2: UTILITY COMMANDS (Direct Exit)
# These commands perform a task and exit the script immediately.
# ==============================================================================

# Check Version
if [[ "$1" == "-v" || "$1" == "--version" ]]; then
    echo "XC-Manager $XC_VERSION"
    return 0

# Initialize Vault
elif [[ "$1" == "init" ]]; then
    mkdir -p "$vault_dir"
    touch -a "$vault_file" 
    echo "Vault initialized at $vault_file"
    return 0

# Clean Vault (Minimalist with Transparency)
elif [[ "$1" == "clean" ]]; then
    [[ ! -f "$vault_file" ]] && echo "Vault not found." && return 1
    
    local -A seen
    local -a unique_lines
    local line
    local count=0

    # Read the file and check each line
    while IFS= read -r line; do
        # 1. Catch empty descriptions
        if [[ "$line" == *'->'([[:space:]]#) ]]; then
            echo "Removing (No Description): $line"
            ((count++))
            continue
        fi

        # 2. Catch identical duplicates
        if [[ -n "${seen[$line]}" ]]; then
            echo "Removing (Duplicate):    $line"
            ((count++))
            continue
        fi

        # 3. If it's a good, unique line, keep it
        unique_lines+=("$line")
        seen[$line]=1
    done < "$vault_file"

    if [[ $count -gt 0 ]]; then
        print -l "${unique_lines[@]}" > "$vault_file"
        echo "--- Done. Removed $count total entries. ---"
    else
        echo "Vault is already clean. Nothing to remove."
    fi
    return 0

# --- Switch or Show Active Vault (v0.3.0 beta) ---
elif [[ "$1" == "use" ]]; then
    if [[ -z "$2" ]]; then
        echo "Active Vault: [${active_name}]"
        echo "Available Vaults:"
        # Look for all .txt files in the vault directory
        for f in "$vault_dir"/*.txt; do
            # Skip if no files exist (handles the literal *.txt string)
            [[ ! -e "$f" ]] && continue
            
            # Get just the name (e.g., 'work' from '/path/to/work.txt')
            local v_name="${f:t:r}"
            
            if [[ "$v_name" == "$active_name" ]]; then
                echo "  * $v_name (active)"
            else
                echo "    $v_name"
            fi
        done
    else
        # Update the state file and switched vault
        echo "$2" > "$state_file"
        echo "Switched to vault: $2"
        [[ ! -f "$vault_dir/$2.txt" ]] && touch "$vault_dir/$2.txt"
    fi
    return 0

# --- Global Search. Search all vaults at once (v0.4.0 beta)
elif [[ "$1" == "search" ]]; then
    # Global search across all vaults
    local selected
    # I use 'grep' to prefix the filename to each line
    selected=$(grep -H ".*" "$vault_dir"/*.txt(N) | fzf \
        --height 40% \
        --layout=reverse \
        --delimiter=":" \
        --with-nth=2.. \
        --preview "echo {1} | sed 's/.*\/\(.*\)\.txt/\1/' | xargs printf 'Vault: [%s]\n\n'; echo {2..}" \
        --header "Global Search (All Vaults)")

    [[ -z "$selected" ]] && return 0

    # Extract the command (everything after the first '->' in the fzf line)
    local cmd=$(echo "$selected" | sed 's/.*-> //')
    
    # Load it into the buffer
    LBUFFER+="$cmd"
    return 0
            
# --- THE FINAL CLOSING TAG ---
else
    echo "Usage: xc {add|list|select|clean|use} [args]"
fi
   
# ==============================================================================
# SECTION 3: PRE-FLIGHT CHECK
# Ensure the vault exists before proceeding to saving logic.
# ==============================================================================
if [[ ! -f "$vault_file" ]]; then
    echo "Vault not found. Please run 'xc init' first."
    return 1
fi

# ==============================================================================
# SECTION 4: COMMAND CAPTURE (The "What")
# This section decides which command we are about to save.
# ==============================================================================
local cmd_to_save

if [[ "$1" == "select" ]]; then
    # Open history selector via FZF
    cmd_to_save=$(fc -rl -100 | sed 's/^[ ]*[0-9]*[ ]*//' | fzf --height 40% --header="Select command to vault" --prompt="Vault > ")
    [[ -z "$cmd_to_save" ]] && echo "Cancelled." && return 0
elif [ $# -eq 0 ]; then
    # Default: Grab the very last command run in shell
    cmd_to_save="${$(fc -ln -1)## #}"
else
    # Take arguments from command line: xc "sudo pacman -Syu"
    cmd_to_save="$*"
fi

# ==============================================================================
# SECTION 5: DESCRIPTION & PERSISTENCE (The "Why")
# Final step: Ask for a comment and write to the vault file.
# ==============================================================================
echo -n "Description for '$cmd_to_save': "
read comment

if [ -n "$comment" ]; then
    echo "$cmd_to_save -> $comment" >> "$vault_file"
    echo "Saved to vault!"
else
    echo "Cancelled."
fi

# ==============================================================================
# END OF SCRIPT
# ==============================================================================
