readonly XC_VERSION="0.6.2"
setopt EXTENDED_GLOB

# ==============================================================================
# SECTION 1: CONFIGURATION & PATHS
# ==============================================================================
local vault_dir="${XC_VAULT_DIR:-$HOME/.local/share/xc}"
local state_file="$HOME/.cache/xc_active_vault"

[[ ! -d "$vault_dir" ]] && mkdir -p "$vault_dir"

local active_name="main"
[[ -f "$state_file" ]] && active_name=$(<"$state_file")

local vault_file="$vault_dir/${active_name}.txt"

# ==============================================================================
# SECTION 2: UTILITY COMMANDS (Direct Exit)
# These commands perform a task and exit the script immediately.
# ==============================================================================

# --- Fast Track Help Check ---
# Only triggers on explicit flags or if the user asks for help.
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
XC-Manager $XC_VERSION
A functional vault for command execution and alias management.

Usage: xc <command> [arguments]

Commands:
  add       Vault a new command or one-liner.
  list      Display all vaulted commands in a searchable TUI.
  select    Open fzf to execute or promote a command to a system alias.
  clean     Interactively remove entries with a safety lock.
  use       Switch between different vault files.
  sync      Download community-curated fix vaults.
  search    Global search across all vaults.
  alias     Promote a vaulted command to a permanent Zsh alias.

Options:
  -v, --version  Show version information.
  -h, --help     Show this help message.

For feedback or bug reports: https://github.com/Rakosn1cek/XC-Manager
EOF
    return 0

# Check Version
elif [[ "$1" == "-v" || "$1" == "--version" ]]; then
    echo "XC-Manager $XC_VERSION"
    return 0

# Initialize Vault
elif [[ "$1" == "init" ]]; then
    mkdir -p "$vault_dir"
    touch -a "$vault_file" 
    echo "Vault initialized at $vault_file"
    return 0

# List Commands (TUI)
elif [[ "$1" == "list" ]]; then
    [[ ! -f "$vault_file" ]] && echo "Vault not found." && return 1
    local selected=$(fzf --height 40% --layout=reverse --header "Select command to EXECUTE" < "$vault_file")
    [[ -z "$selected" ]] && return 0
    LBUFFER+="${selected%% -> *}"
    return 0

# Clean Vault
elif [[ "$1" == "clean" ]]; then
    [[ ! -f "$vault_file" ]] && echo "Vault not found." && return 1
    
    local -A seen
    local -a unique_lines
    local line
    local count=0

    while IFS= read -r line; do
        if [[ "$line" == *'->'([[:space:]]#) ]]; then
            echo "Removing (No Description): $line"
            ((count++))
            continue
        fi

        if [[ -n "${seen[$line]}" ]]; then
            echo "Removing (Duplicate):    $line"
            ((count++))
            continue
        fi

        unique_lines+=("$line")
        seen[$line]=1
    done < "$vault_file"

    if [[ $count -gt 0 ]]; then
        print -l "${unique_lines[@]}" > "$vault_file"
        echo "--- Done. Removed $count total entries. ---"
    else
        echo "Vault is already clean. Nothing to remove."
    fi
    return 0

# Switch or Show Active Vault
elif [[ "$1" == "use" ]]; then
    if [[ -z "$2" ]]; then
        echo "Active Vault: [${active_name}]"
        echo "Available Vaults:"
        for f in "$vault_dir"/*.txt(N); do
            local v_name="${f:t:r}"
            [[ "$v_name" == "$active_name" ]] && echo "  * $v_name (active)" || echo "    $v_name"
        done
    else
        echo "$2" > "$state_file"
        echo "Switched to vault: $2"
        [[ ! -f "$vault_dir/$2.txt" ]] && touch "$vault_dir/$2.txt"
    fi
    return 0

# Sync Community Vaults / New in v0.6.0
elif [[ "$1" == "sync" ]]; then
    local category="$2"
    local remote_base="https://raw.githubusercontent.com/Rakosn1cek/XC-Manager/main/community-vaults"
    
    if [[ -z "$category" ]]; then
        echo "Usage: xc sync <category> (e.g., arch, hyprland, macos)"
        return 1
    fi

    echo "Fetching [$category] vault from community repository..."
    
    # Use curl -f to ensure we don't save 404 error pages as text files
    if curl -s -f "$remote_base/${category}.txt" -o "$vault_dir/${category}.txt"; then
        echo "Successfully synced: ${category}.txt"
        echo "Currently using: [${active_name}]. Run 'xc use $category' to switch."
    else
        echo "Error: Community vault '$category' not found or network failure."
        return 1
    fi
    return 0
    
# Global Search
elif [[ "$1" == "search" ]]; then
    # We grab the file:command, dedup by command, and send to fzf
    local selected=$(grep -H ".*" "$vault_dir"/*.txt(N) | \
        awk -F: '!visited[$2]++' | fzf \
        --height 40% \
        --layout=reverse \
        --delimiter=":" \
        --with-nth=2.. \
        --preview "echo {1} | sed 's/.*\/\(.*\)\.txt/\1/' | xargs printf 'Vault: [%s]\n\n'; echo {2..}" \
        --header "Global Search (All Vaults)")

    [[ -z "$selected" ]] && return 0

    # The Fix: Use awk to grab everything after the first colon safely
    local cmd_to_buffer=$(echo "$selected" | awk -F: '{sub(/[^:]*:/, ""); print}')
    
    LBUFFER+="$cmd_to_buffer"
    return 0

# Alias Promotion
elif [[ "$1" == "alias" ]]; then
    local alias_file="$vault_dir/aliases.zsh"
    touch "$alias_file"
    local selected=$(fzf --height 40% --layout=reverse --header "Select command to ALIAS" < "$vault_file")
    [[ -z "$selected" ]] && return 0
    local cmd="${selected%% -> *}"
    echo -n "Enter alias name for '$cmd': "
    read alias_name
    [[ -z "$alias_name" ]] && return 0
    echo "alias $alias_name='$cmd'" >> "$alias_file"
    echo "Alias '$alias_name' added."
    return 0

# Final Catch-all for unrecognized flags/commands in Section 2
elif [[ "$1" == -* ]]; then
    echo "Unrecognized option: $1. Use --help for usage."
    return 1
fi
    
# ==============================================================================
# SECTION 3: PRE-FLIGHT CHECK
# ==============================================================================
if [[ ! -f "$vault_file" ]]; then
    echo "Vault not found. Please run 'xc init' first."
    return 1
fi

# ==============================================================================
# SECTION 4: COMMAND CAPTURE & NORMALIZATION (The "What")
# ==============================================================================
local cmd_to_save

if [[ "$1" == "select" ]]; then
    cmd_to_save=$(fc -rl -100 | sed 's/^[ ]*[0-9]*[ ]*//' | fzf --height 40% --header="Select command to vault" --prompt="Vault > ")
    [[ -z "$cmd_to_save" ]] && echo "Cancelled." && return 0
elif [[ "$1" == "add" ]]; then
    shift
    cmd_to_save="$*"
elif [[ -z "$1" ]]; then
    cmd_to_save="${$(fc -ln -1)## #}"
else
    cmd_to_save="$*"
fi

# --- NEW: Semantic Normalization ---
# Collapses spaces but keeps the variable name you used
cmd_to_save="${(j: :)${(z)cmd_to_save}}"

# --- NEW: Duplicate Guard Logic ---
# Using the vault_file path defined in Section 1
if [[ -f "$vault_file" ]] && grep -q "^${cmd_to_save} ->" "$vault_file"; then
    print -P "%F{yellow}ℹ Command already exists in [${active_name}]. Skipping.%f"
    return 0
fi

# ==============================================================================
# SECTION 5: DESCRIPTION & PERSISTENCE (The "Why")
# ==============================================================================
echo -n "Description for '$cmd_to_save': "
read comment

if [[ -n "$comment" ]]; then
    echo "$cmd_to_save -> $comment" >> "$vault_file"
    echo "Saved to vault!"
else
    echo "Cancelled."
fi
