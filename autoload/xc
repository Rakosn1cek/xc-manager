readonly XC_VERSION="0.7.0"
setopt EXTENDED_GLOB

# ==============================================================================
# SECTION 1: CONFIGURATION & PATHS
# ==============================================================================
local vault_dir="${XC_VAULT_DIR:-$HOME/.local/share/xc}"
local state_file="$HOME/.cache/xc_active_vault"

[[ ! -d "$vault_dir" ]] && mkdir -p "$vault_dir"

local active_name="main"
[[ -f "$state_file" ]] && active_name=$(<"$state_file")

local vault_file="$vault_dir/${active_name}.txt"

# --- Placeholder Processor Helper ---
__xc_fill_placeholders() {
    local cmd="$1"
    while [[ "$cmd" == *"{{"*"}}"* ]]; do
        local front="${cmd%%\}\}*}"
        local var_name="${front##*\{\{}"
        echo -n "Value for {{$var_name}} (or press Ctrl+C to cancel): "
        read user_input
        
        # Hardening: Check for empty input to prevent syntax errors
        if [[ -z "$user_input" ]]; then
            echo "Error: Placeholder cannot be empty. Execution cancelled." >&2
            return 1
        fi

        # Global swap: replaces all identical placeholder names at once
        cmd="${cmd//\{\{$var_name\}\}/$user_input}"
    done
    echo "$cmd"
}

# ==============================================================================
# SECTION 2: UTILITY COMMANDS (Direct Exit)
# ==============================================================================

# --- Fast Track Help Check ---
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
XC-Manager $XC_VERSION
A functional vault for command execution and alias management.

Usage: xc <command> [arguments]

Commands:
  add       Vault a new command or one-liner.
  list      Searchable TUI for executing commands. Supports {{placeholders}}.
  select    Open fzf to vault a command from your history.
  clean     Interactively remove entries with a safety lock.
  use       Switch between different vault files.
  sync      Interactive "Package Manager" for community vaults.
  search    Global search across all vaults. Supports {{placeholders}}.
  alias     Promote a vaulted command to a permanent Zsh alias.

Templating:
  Use {{var}} in your commands to create interactive prompts.
  Example: "ssh {{user}}@{{host}}" will ask for user and host on execution.
  Download templates: Run 'xc sync templates' to get started.  

Options:
  -v, --version  Show version information.
  -h, --help     Show this help message.

For feedback or bug reports: https://github.com/Rakosn1cek/XC-Manager
EOF
    return 0

# Check Version
elif [[ "$1" == "-v" || "$1" == "--version" ]]; then
    echo "XC-Manager $XC_VERSION"
    return 0

# Initialise Vault
elif [[ "$1" == "init" ]]; then
    mkdir -p "$vault_dir"
    touch -a "$vault_file" 
    echo "Vault initialized at $vault_file"
    return 0

# List Commands (TUI)
elif [[ "$1" == "list" ]]; then
    [[ ! -f "$vault_file" ]] && echo "Vault not found." && return 1
    
    # Keep your original fzf flags exactly as they are in your screenshot
    local selected=$(fzf --height 40% --layout=reverse --header "Select command to EXECUTE" < "$vault_file")
    
    [[ -z "$selected" ]] && return 0
    
    local raw_cmd="${selected%% -> *}"
    
    # Logic Hardening: Verify the placeholders were actually filled
    local filled_cmd=$(__xc_fill_placeholders "$raw_cmd")
    
    # Only update the command line if the result is valid
    [[ -n "$filled_cmd" ]] && LBUFFER+="$filled_cmd"
    
    return 0

# Clean Vault
elif [[ "$1" == "clean" ]]; then
    [[ ! -f "$vault_file" ]] && echo "Vault not found." && return 1
    
    local -A seen
    local -a unique_lines
    local line
    local count=0

    while IFS= read -r line; do
        if [[ "$line" == *'->'([[:space:]]#) ]]; then
            echo "Removing (No Description): $line"
            ((count++))
            continue
        fi

        if [[ -n "${seen[$line]}" ]]; then
            echo "Removing (Duplicate):    $line"
            ((count++))
            continue
        fi

        unique_lines+=("$line")
        seen[$line]=1
    done < "$vault_file"

    if [[ $count -gt 0 ]]; then
        print -l "${unique_lines[@]}" > "$vault_file"
        echo "--- Done. Removed $count total entries. ---"
    else
        echo "Vault is already clean. Nothing to remove."
    fi
    return 0

# Switch or Show Active Vault
elif [[ "$1" == "use" ]]; then
    if [[ -z "$2" ]]; then
        echo "Active Vault: [${active_name}]"
        echo "Available Vaults:"
        for f in "$vault_dir"/*.txt(N); do
            local v_name="${f:t:r}"
            [[ "$v_name" == "$active_name" ]] && echo "  * $v_name (active)" || echo "    $v_name"
        done
    else
        echo "$2" > "$state_file"
        echo "Switched to vault: $2"
        [[ ! -f "$vault_dir/$2.txt" ]] && touch "$vault_dir/$2.txt"
    fi
    return 0

# Sync Community Vaults (v0.7.0 Package Manager Style)
elif [[ "$1" == "sync" ]]; then
    local sub_cmd="$2"
    local remote_base="https://raw.githubusercontent.com/Rakosn1cek/XC-Manager/main/community-vaults"
    local category
    
    # If no argument is provided, fetch the index and show fzf for selection
    if [[ -z "$sub_cmd" ]]; then
        echo "Fetching available community vaults..."
        local index=$(curl -s -f "$remote_base/index.txt")
        
        if [[ -z "$index" ]]; then
            echo "Error: Could not retrieve vault index. Check your connection or repository."
            return 1
        fi

        # User selects from the index; It only cares about the category name before the colon
        local selected=$(echo "$index" | fzf --height 40% --layout=reverse --header "Select a vault to SYNC" --prompt="Sync > ")
        [[ -z "$selected" ]] && return 0
        category="${selected%%:*}"
    else
        category="$sub_cmd"
    fi

    echo "Downloading [$category]..."
        local local_target="$vault_dir/${category}.txt"
    
        # Safety Check: Prevent accidental data loss of local customisations
        if [[ -f "$local_target" ]]; then
            echo -n "Vault '${category}' already exists locally. Overwrite with community version? [y/N]: "
            read confirm
            if [[ "$confirm" != [yY] ]]; then
                echo "Sync cancelled. Local vault preserved."
                return 0
            fi
        fi
    
        if curl -s -f "$remote_base/${category}.txt" -o "$local_target"; then
            echo "Successfully synchronised: ${category}.txt"
            echo "Run 'xc use $category' to switch to this vault."
        else
            echo "Error: Community vault '$category' not found at $remote_base/${category}.txt"
            return 1
        fi
        return 0
    
# Global Search
elif [[ "$1" == "search" ]]; then
    local selected=$(grep -H ".*" "$vault_dir"/*.txt(N) | \
        awk -F: '!visited[$2]++' | fzf \
        --height 40% \
        --layout=reverse \
        --delimiter=":" \
        --with-nth=2.. \
        --preview "echo {1} | sed 's/.*\/\(.*\)\.txt/\1/' | xargs printf 'Vault: [%s]\n\n'; echo {2..}" \
        --header "Global Search (All Vaults)")

    [[ -z "$selected" ]] && return 0

    # Extract the command, then strip description BEFORE processing placeholders
    local entry=$(echo "$selected" | awk -F: '{sub(/[^:]*:/, ""); print}')
    local raw_cmd="${entry%% -> *}"
    LBUFFER+="$(__xc_fill_placeholders "$raw_cmd")"
    return 0

# Alias Promotion
elif [[ "$1" == "alias" ]]; then
    local alias_file="$vault_dir/aliases.zsh"
    touch "$alias_file"
    local selected=$(fzf --height 40% --layout=reverse --header "Select command to ALIAS" < "$vault_file")
    [[ -z "$selected" ]] && return 0
    local cmd="${selected%% -> *}"
    echo -n "Enter alias name for '$cmd': "
    read alias_name
    [[ -z "$alias_name" ]] && return 0
    echo "alias $alias_name='$cmd'" >> "$alias_file"
    echo "Alias '$alias_name' added."
    return 0

# Final Catch-all for unrecognised flags/commands
elif [[ "$1" == -* ]]; then
    echo "Unrecognized option: $1. Use --help for usage."
    return 1
fi
    
# ==============================================================================
# SECTION 3: PRE-FLIGHT CHECK
# ==============================================================================
if [[ ! -f "$vault_file" ]]; then
    echo "Vault not found. Please run 'xc init' first."
    return 1
fi

# ==============================================================================
# SECTION 4: COMMAND CAPTURE & NORMALISATION
# ==============================================================================
local cmd_to_save

if [[ "$1" == "select" ]]; then
    cmd_to_save=$(fc -rl -100 | sed 's/^[ ]*[0-9]*[ ]*//' | fzf --height 40% --header="Select command to vault" --prompt="Vault > ")
    [[ -z "$cmd_to_save" ]] && echo "Cancelled." && return 0
elif [[ "$1" == "add" ]]; then
    shift
    cmd_to_save="$*"
elif [[ -z "$1" ]]; then
    cmd_to_save="${$(fc -ln -1)## #}"
else
    cmd_to_save="$*"
fi

cmd_to_save="${(j: :)${(z)cmd_to_save}}"

if [[ -f "$vault_file" ]] && grep -q "^${cmd_to_save} ->" "$vault_file"; then
    print -P "%F{yellow}ℹ Command already exists in [${active_name}]. Skipping.%f"
    return 0
fi

# ==============================================================================
# SECTION 5: DESCRIPTION & PERSISTENCE
# ==============================================================================
echo -n "Description for '$cmd_to_save': "
read comment

if [[ -n "$comment" ]]; then
    echo "$cmd_to_save -> $comment" >> "$vault_file"
    echo "Saved to vault!"
else
    echo "Cancelled."
fi
